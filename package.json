{
  "name": "openanime",
  "desktopName": "openanime",
  "version": "1.1.9",
  "main": "launcher.js",
  "description": "OpenAnime için geliştirilmiş, resmi olmayan (unofficial), yerel WebGPU destekli Linux istemcisi.",
  "author": "tuanapi <tuanapi@proton.me>",
  "homepage": "https://github.com/tuanapi/OpenAnime-Linux",
  "license": "MIT",
  "scripts": {
    "start": "bash start.sh",
    "dist": "electron-builder",
    "diagnose": "electron . --diagnose",
    "gpu-detect": "node scripts/gpu-detect.js --self-test"
  },
  "build": {
    "appId": "io.github.tuanapi.OpenAnime",
    "productName": "OpenAnime",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz",
        "pacman"
      ],
      "category": "Video",
      "icon": "icon512.png",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libxkbcommon0",
        "libxkbfile1",
        "libasound2t64 | libasound2",
        "libcups2",
        "libgbm1"
      ],
      "fpm": [
        "--deb-changelog",
        "packaging/deb-changelog.txt"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "libxkbcommon",
        "libxkbfile",
        "alsa-lib",
        "cups-libs",
        "mesa-libgbm"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "alsa-lib",
        "libxtst",
        "libxkbfile",
        "libxkbcommon",
        "libcups",
        "mesa"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "launcher.js",
      "main.js",
      "preload.js",
      "injected.js",
      "scripts/",
      "!scripts/repo",
      "icon512.png",
      "package.json",
      "!packaging",
      "!venv"
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
