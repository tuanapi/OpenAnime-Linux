{
  "name": "openanime",
  "version": "1.1.7",
  "main": "launcher.js",
  "description": "OpenAnime için geliştirilmiş, resmi olmayan (unofficial), yerel WebGPU destekli Linux istemcisi.",
  "author": "tuanapi <tuanapi@proton.me>",
  "homepage": "https://github.com/tuanapi/OpenAnime-Linux",
  "license": "MIT",
  "scripts": {
    "start": "bash start.sh",
    "dist": "electron-builder",
    "diagnose": "electron . --diagnose",
    "gpu-detect": "node scripts/gpu-detect.js --self-test"
  },
  "build": {
    "appId": "io.github.tuanapi.OpenAnime",
    "productName": "OpenAnime",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz",
        "pacman"
      ],
      "category": "Video",
      "icon": "icon512.png"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "alsa-lib",
        "libxtst",
        "libxkbfile"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "launcher.js",
      "main.js",
      "preload.js",
      "scripts/",
      "icon512.png",
      "screenshots/",
      "package.json",
      "!packaging",
      "!venv"
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  }
}
